                                "type": "text/javascript",
                                "exec": [
                                    "const next = (name) =\u003e (pm.execution \u0026\u0026 pm.execution.setNextRequest ? pm.execution.setNextRequest(name) : postman.setNextRequest(name));",
                                    "const body = pm.response.json();",
                                    "if (pm.response.code !== 200) { console.log(\u0027Status check failed:\u0027, body.error); next(null); return; }",
                                    "const count = Number(pm.collectionVariables.get(\u0027pollCount\u0027) || 0) + 1;",
                                    "pm.collectionVariables.set(\u0027pollCount\u0027, String(count));",
                                    "console.log(`Check ${count}: ${body.state} · ${body.progress}% · ${body.message}`);",
                                    "const finished = [\u0027done\u0027, \u0027needs_review\u0027, \u0027failed\u0027].includes(body.state);",
                                    "if (finished) {",
                                    "  pm.test(`Finished: ${body.state}`, () =\u003e pm.expect(body.state).to.not.equal(\u0027failed\u0027));",
                                    "  if (body.pdf \u0026\u0026 body.pdf.url) { pm.collectionVariables.set(\u0027pdfUrl\u0027, body.pdf.url); next(\u00273. Download PDF\u0027); }",
                                    "  else { next(null); }",
                                    "  return;",
                                    "}",
                                    "if (count \u003e= 60) { console.log(\u0027Still not finished after about 15 minutes; stopping.\u0027); next(null); return; }",
                                    "// Wait 15 seconds (the sandbox waits for this timer), then ask again.",
                                    "setTimeout(() =\u003e {}, 15000);",
                                    "next(\u00272. Wait until finished\u0027);"
