        {
            "name": "Get job status",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "if (!pm.collectionVariables.get(\u0027jobId\u0027)) { throw new Error(\u0027No jobId yet. Send a Create job request first, or set the jobId collection variable.\u0027); }"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test(\u0027Status returned (200)\u0027, () =\u003e pm.response.to.have.status(200));",
                            "const body = pm.response.json();",
                            "if (pm.response.code !== 200) { console.log(body.error); return; }",
                            "console.log(`${body.state} · ${body.progress}% · ${body.message}`);",
                            "if (body.pdf \u0026\u0026 body.pdf.url) { pm.collectionVariables.set(\u0027pdfUrl\u0027, body.pdf.url); }",
                            "",
                            "// Response → Visualize tab: a readable progress view.",
                            "const template = `",
                            "\u003cstyle\u003e",
                            "  body { font-family: -apple-system, \u0027Segoe UI\u0027, Helvetica, Arial, sans-serif; color: #231f20; margin: 0; padding: 16px; }",
                            "  .card { max-width: 560px; border: 1px solid #e2e5ea; border-radius: 10px; padding: 20px 22px; }",
                            "  h2 { margin: 0 0 4px; font-size: 20px; }",
                            "  .id { font: 12px monospace; color: #5c6770; word-break: break-all; }",
                            "  .badge { display: inline-block; margin-top: 14px; padding: 4px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .04em; }",
                            "  .queued { background: #eef0f3; color: #5c6770; } .running { background: #e6eefa; color: #1e4f9a; }",
                            "  .done { background: #e3f6ea; color: #17803d; } .needs_review { background: #fff3dc; color: #a35d00; } .failed { background: #fde7e7; color: #b42318; }",
                            "  .msg { margin: 10px 0 0; font-size: 14px; line-height: 1.5; }",
                            "  .bar { height: 10px; margin-top: 14px; background: #eef0f3; border-radius: 999px; overflow: hidden; }",
                            "  .fill { height: 100%; background: #1e4f9a; border-radius: 999px; }",
                            "  .fill.done { background: #22a352; } .fill.needs_review { background: #e39b1b; } .fill.failed { background: #d64545; }",
                            "  .pct { text-align: right; font-size: 12px; color: #5c6770; margin-top: 4px; }",
                            "  ul { list-style: none; padding: 0; margin: 14px 0 0; border-top: 1px solid #eef0f3; }",
                            "  li { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eef0f3; font-size: 14px; color: #9aa3ad; }",
                            "  li.done { color: #231f20; } li.in_progress { color: #1e4f9a; font-weight: 600; } li.stopped { color: #a35d00; font-weight: 600; }",
                            "  .note { margin-top: 14px; padding: 10px 12px; border-radius: 6px; background: #fff8eb; border: 1px solid #f3d9a6; font-size: 13px; }",
                            "  .err { background: #fff1f1; border-color: #f2c4c4; }",
                            "  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin: 14px 0 0; padding: 12px; background: #f7f8fa; border-radius: 6px; }",
                            "  dt { font-size: 10px; font-weight: 800; text-transform: uppercase; color: #5c6770; } dd { margin: 4px 0 0; font-size: 14px; font-weight: 600; }",
                            "  a.btn { display: block; margin-top: 16px; padding: 12px; text-align: center; background: #1e4f9a; color: #fff; border-radius: 6px; font-weight: 800; text-decoration: none; }",
                            "  .times { margin-top: 12px; font-size: 12px; color: #8a939c; }",
                            "\u003c/style\u003e",
                            "\u003cdiv class=\u0027card\u0027\u003e",
                            "  \u003ch2\u003eCustom design proof\u003c/h2\u003e",
                            "  \u003cdiv class=\u0027id\u0027\u003e{{jobId}}\u003c/div\u003e",
                            "  \u003cspan class=\u0027badge {{state}}\u0027\u003e{{stateLabel}}\u003c/span\u003e",
                            "  \u003cp class=\u0027msg\u0027\u003e{{message}}\u003c/p\u003e",
                            "  \u003cdiv class=\u0027bar\u0027\u003e\u003cdiv class=\u0027fill {{state}}\u0027 style=\u0027width: {{barWidth}}%\u0027\u003e\u003c/div\u003e\u003c/div\u003e",
                            "  \u003cdiv class=\u0027pct\u0027\u003e{{progress}}%\u003c/div\u003e",
                            "  {{#if pdf}}\u003ca class=\u0027btn\u0027 href=\u0027{{pdf.url}}\u0027 target=\u0027_blank\u0027\u003eDownload PDF (link valid 15 min)\u003c/a\u003e{{/if}}",
                            "  {{#if reason}}\u003cdiv class=\u0027note\u0027\u003e\u003cb\u003eWhy it needs an artist:\u003c/b\u003e {{reason}}\u003c/div\u003e{{/if}}",
                            "  {{#if error}}\u003cdiv class=\u0027note err\u0027\u003e\u003cb\u003eWhat went wrong:\u003c/b\u003e {{error}}\u003c/div\u003e{{/if}}",
                            "  \u003cul\u003e{{#each steps}}\u003cli class=\u0027{{status}}\u0027\u003e\u003cspan\u003e{{label}}\u003c/span\u003e\u003cspan\u003e{{statusLabel}}\u003c/span\u003e\u003c/li\u003e{{/each}}\u003c/ul\u003e",
                            "  {{#if garmentRows.length}}\u003cdl\u003e{{#each garmentRows}}\u003cdiv\u003e\u003cdt\u003e{{label}}\u003c/dt\u003e\u003cdd\u003e{{value}}\u003c/dd\u003e\u003c/div\u003e{{/each}}\u003c/dl\u003e{{/if}}",
                            "  \u003cdiv class=\u0027times\u0027\u003eQuality: {{quality}}{{#if submittedAt}} · Submitted {{submittedAt}}{{/if}}{{#if updatedAt}} · Updated {{updatedAt}}{{/if}}\u003c/div\u003e",
                            "\u003c/div\u003e`;",
                            "",
                            "const stateLabels = { queued: \u0027Queued\u0027, running: \u0027In progress\u0027, done: \u0027Ready\u0027, needs_review: \u0027Artist review\u0027, failed: \u0027Not completed\u0027 };",
                            "const stepLabels = { done: \u0027Done\u0027, in_progress: \u0027Working…\u0027, waiting: \u0027\u0027, stopped: \u0027Stopped here\u0027, skipped: \u0027Skipped\u0027 };",
                            "const g = body.garment || {};",
                            "const garmentRows = [[\u0027Garment\u0027, g.name], [\u0027Style #\u0027, g.style], [\u0027Category\u0027, g.category], [\u0027Fit\u0027, g.gender], [\u0027Size\u0027, g.size]]",
                            "  .filter((row) =\u003e row[1]).map(([label, value]) =\u003e ({ label, value }));",
                            "const when = (iso) =\u003e iso ? new Date(iso).toLocaleString() : null;",
                            "pm.visualizer.set(template, {",
                            "  ...body,",
                            "  stateLabel: stateLabels[body.state] || body.state,",
                            "  barWidth: Math.max(body.progress || 0, 3),",
                            "  steps: (body.steps || []).map((s) =\u003e ({ ...s, statusLabel: stepLabels[s.status] || \u0027\u0027 })),",
                            "  garmentRows,",
                            "  submittedAt: when(body.submittedAt),",
                            "  updatedAt: when(body.updatedAt)",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [],
                "url": {
                    "raw": "{{baseUrl}}/jobs/{{jobId}}",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "jobs",
                        "{{jobId}}"
                    ]
                },
                "description": "Uses the `jobId` saved by the last **Create job** request. Send it every 10–15 seconds. Open the response **Visualize** tab for a progress view. When the PDF is ready its link is saved into `pdfUrl`."
            },
