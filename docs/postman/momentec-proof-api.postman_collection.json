                                    "const next = (name) =\u003e (pm.execution \u0026\u0026 pm.execution.setNextRequest ? pm.execution.setNextRequest(name) : postman.setNextRequest(name));",
                                    "const body = pm.response.json();",
                                    "if (!body.jobId) { console.log(\u0027Not created:\u0027, body.error); next(null); return; }",
                                    "pm.collectionVariables.set(\u0027jobId\u0027, body.jobId);",
                                    "pm.collectionVariables.set(\u0027pdfUrl\u0027, \u0027\u0027);",
