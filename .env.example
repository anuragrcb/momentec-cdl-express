# Gemini API key used for /api/analyze (vision: reads sport/garment/colors off
# the uploaded artwork). Get one from https://aistudio.google.com/apikey.
# Keep this value only in .env or the deployment secret store; never commit it.
GEMINI_API_KEY=

# Base URL of the sibling 3d-garment-retexture service - the ACTIVELY-DEVELOPED
# copy at Caroma-Poc/3d-garment-retexture (its own repo, its own .env, its own
# npm start). Do NOT point this at the stale, untouched-since-Aug-13 copy that
# sits directly under JourneyAX/3d-garment-retexture - it no longer matches
# the API contract this app integrates against (no backImg/leftImg/rightImg
# fields, no 'augusta' mode). The correct copy's own .env sets PORT=4000; this
# app runs on :3200 so the two do not collide when both are started.
RETEXTURE_SERVICE_URL=http://localhost:4000

# REQUIRED IN THE SIBLING RETEXTURE SERVICE'S OWN .env:
# GEMINI_API_KEY=...  # Generates only the back/left/right views that the
# customer did not upload, using the selected Augusta GLB silhouette.

# Magnific API key used for the "Prepare artwork" step (background removal +
# precision upscale on the customer's uploaded photo, before style matching).
# Get one from https://magnific.com. If unset, that step is skipped and the
# original upload is used untouched - same honest-fallback pattern as
# GEMINI_API_KEY above. The application first stages image bytes using
# Magnific's signed-upload API, so the preparation flow also works in local
# development without exposing the customer's image from localhost.
MAGNIFIC_API_KEY=

# Magnific MCP credentials used only by the server-side Step 5 vector package.
# The refresh token is obtained with the standalone-asset-extractor OAuth flow.
# Never prefix these variables with NEXT_PUBLIC_.
MAGNIFIC_MCP_CLIENT_ID=
MAGNIFIC_MCP_CLIENT_SECRET=
MAGNIFIC_MCP_REFRESH_TOKEN=
# Optional short-lived alternative for local troubleshooting only.
MAGNIFIC_MCP_ACCESS_TOKEN=
MAGNIFIC_MCP_MODEL=imagen-nano-banana-2

# Required for persistent private uploads, SVG packages and submitted request
# records on Vercel. `vercel env pull` supplies this after a Blob store is linked.
# Local development works without it and writes under data/ instead.
BLOB_READ_WRITE_TOKEN=
