# Gemini API key used for /api/analyze (vision: reads sport/garment/colors off
# the uploaded artwork). Get one from https://aistudio.google.com/apikey
# Same key source pattern as the sibling 3d-garment-retexture service.
GEMINI_API_KEY=

# Base URL of the sibling 3d-garment-retexture service (its own repo, its own
# .env, its own npm start). It listens on :3000 by default; this app runs on
# :3200 so the two do not collide when both are started with `npm start`.
RETEXTURE_SERVICE_URL=http://localhost:3000
